{
  "name": "nexusport-system",
  "version": "1.0.0",
  "description": "NexusPort - Sistema de Gestão Operacional Portuária para o Porto de Santos (STS-01)",
  "main": "index.html",
  "scripts": {
    "start": "npx serve -l 3000 .",
    "test": "python3 tests/python/verify_phase4.py && python3 tests/python/verify_phase5.py && python3 tests/python/verify_phase6.py && python3 tests/python/verify_phase7.py && python3 tests/python/verify_phase8.py && python3 tests/python/verify_phase9.py",
    "test:graficos": "node tests/unit/test_graficos_por_cargo.js",
    "test:refresh": "node tests/unit/test_charts_refresh.js",
    "test:autorefresh": "node tests/unit/test_charts_autorefresh.js",
    "test:bercos": "node tests/unit/test_bercos_vinculo.js",
    "test:xss": "node tests/unit/xss.test.js",
    "scan:xss": "node tools/scanners/xss-scan.js",
    "audit:xss": "node tools/scanners/xss-scan.js && node tests/unit/xss.test.js",
    "test:haptics": "node tests/unit/test_haptics.js",
    "test:migracao": "node tests/unit/test_emergencias_404.js",
    "test:panic": "node tests/unit/test_panic_global.js && node tests/unit/test_emergencias_404.js && node tests/unit/test_enum_emergencia.js",
    "test:enum": "node tests/unit/test_enum_emergencia.js",
    "test:net-debug": "node tests/unit/test_net_debug.js",
    "test:backlog3": "node tests/unit/test_backlog3_correcoes.js && node tests/unit/test_backlog3_restantes.js",
    "test:backlog3:restantes": "node tests/unit/test_backlog3_restantes.js",
    "test:webmcp": "node tests/unit/test_webmcp.js && node tests/unit/test_webmcp_paginas.js",
    "test:gravacao": "node tests/unit/test_gravacao_inspecao_login.js",
    "test:single-flight": "node tests/unit/test_single_flight.js"
  },
  "keywords": [
    "nexusport",
    "port-management",
    "logistics",
    "supabase",
    "rls"
  ],
  "author": "NexusPort Team",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
