{
  "name": "nexusport-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentação técnica completa do NexusPort (Docusaurus). A saída do build é publicada em ../docs.",
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "node scripts/copiar-capturas.js",
    "start": "docusaurus start --host 0.0.0.0",
    "prebuild": "node scripts/copiar-capturas.js",
    "build": "docusaurus build --out-dir ../docs",
    "postbuild": "node scripts/relatorio-build.js",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --dir ../docs --host 0.0.0.0",
    "swizzle": "docusaurus swizzle",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
